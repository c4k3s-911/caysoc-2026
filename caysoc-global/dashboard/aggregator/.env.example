# CaySoc Dashboard Aggregator (cx-serv1 / local)
PORT=4310
BIND=127.0.0.1
CAYSOC_MOCK=1
CAYSOC_REAL_ZERODAYS=1
TZ=Africa/Johannesburg
# FX: leave unset to use 0days/_index.md FX (recommended); set FX_USD_ZAR to override explicitly.
# FX_USD_ZAR=16.28
# FX_SOURCE=manual
# Paperclip (read-only adapter; verify endpoints/auth against your build)
PAPERCLIP_ENABLED=0
PAPERCLIP_BASE_URL=http://127.0.0.1:3100
PAPERCLIP_COMPANY_ID=5ef64648-3fbd-4492-a973-0b6e35b34a17
PAPERCLIP_API_TOKEN=
PAPERCLIP_TIMEOUT_MS=5000
# CayScaN (read-only, governed; no exploit/control path)
CAYSCAN_ENABLED=0
CAYSCAN_BASE_URL=http://192.168.7.3:8443
CAYSCAN_API_TOKEN=
CAYSCAN_TIMEOUT_MS=5000
# 0days source (local Windows example shown; on cx-serv1 use /home/cx/caysoc/data/0days)
ZERODAY_ROOT=D:/Projects/0xsec.za/0days
CORS_ORIGIN=http://127.0.0.1:3100
