# CaySoc Global / Paperclip - cx-serv1 (192.168.0.4) environment template
# Copy to .env on the VPS and fill values. NEVER commit .env.
# Rotate any credentials previously shared in plaintext.

PAPERCLIP_HOST=192.168.0.4
PAPERCLIP_PORT=3100
PAPERCLIP_PUBLIC_URL=http://192.168.0.4:3100
PAPERCLIP_DEPLOYMENT_MODE=authenticated
PAPERCLIP_DEPLOYMENT_EXPOSURE=private
SERVE_UI=true

BETTER_AUTH_SECRET=__GENERATE_openssl_rand_hex_32__
DATABASE_URL=postgres://paperclip:__CHANGE_ME__@127.0.0.1:5432/paperclip

FREE_ONLY=1
GATEWAY_BASE_URL=http://127.0.0.1:20128/v1
OPENAI_BASE_URL=http://127.0.0.1:20128/v1
OPENAI_API_KEY=__SET_IN_SECRET_STORE__
VERCEL_AI_GATEWAY_KEY=__OPTIONAL_SET_IN_SECRET_STORE__

OPENCODE_MODEL=omni/free
CODEX_MODEL=omni/free
CLAUDE_MODEL=omni/free
HERMES_MODEL=omni/free

TZ=Africa/Johannesburg
CAYSOC_LOCALE=en_ZA
CAYSOC_CURRENCY=ZAR
