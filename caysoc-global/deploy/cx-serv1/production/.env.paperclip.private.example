# cx-serv1 Paperclip private env (example) - copy to .env.paperclip.private, fill secrets, chmod 600, never commit.
# ROTATE any secrets previously stored in docker-compose.paperclip.yml or exposed elsewhere.
BETTER_AUTH_SECRET=__GENERATE_STRONG_RANDOM__
PAPERCLIP_TOOL_ACTION_SIGNING_SECRET=__GENERATE_STRONG_RANDOM__
PAPERCLIP_PUBLIC_URL=https://paperclip.your-tailnet.ts.net
# DATABASE_URL=...  # only if your deployment requires an external DB; verify instance config before changing
PAPERCLIP_DATA_DIR=/paperclip
